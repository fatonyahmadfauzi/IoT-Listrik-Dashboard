{
  "rules": {
    "admin_secure": {
      ".read": false,
      ".write": false
    },

    "rate_limits": {
      ".read": false,
      ".write": false
    },

    "listrik": {
      ".read": "auth != null && auth.token.isTempAccount !== true",
      "arus": {
        ".write": "auth != null && auth.token.email === 'listrik.iot.device@gmail.com'",
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200"
      },
      "tegangan": {
        ".write": "auth != null && auth.token.email === 'listrik.iot.device@gmail.com'",
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 300"
      },
      "daya": {
        ".write": "auth != null && auth.token.email === 'listrik.iot.device@gmail.com'",
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60000"
      },
      "daya_w": {
        ".write": "auth != null && auth.token.email === 'listrik.iot.device@gmail.com'",
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60000"
      },
      "apparent_power": {
        ".write": "auth != null && auth.token.email === 'listrik.iot.device@gmail.com'",
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60000"
      },
      "energi_kwh": {
        ".write": "auth != null && auth.token.email === 'listrik.iot.device@gmail.com'",
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
      },
      "frekuensi": {
        ".write": "auth != null && auth.token.email === 'listrik.iot.device@gmail.com'",
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 70"
      },
      "power_factor": {
        ".write": "auth != null && auth.token.email === 'listrik.iot.device@gmail.com'",
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1.2"
      },
      "sensor_source": {
        ".write": "auth != null && auth.token.email === 'listrik.iot.device@gmail.com'",
        ".validate": "newData.isString() && newData.val().length <= 80"
      },
      "status": {
        ".write": "auth != null && auth.token.email === 'listrik.iot.device@gmail.com'",
        ".validate": "newData.isString() && (newData.val() === 'NORMAL' || newData.val() === 'WARNING' || newData.val() === 'LEAKAGE' || newData.val() === 'DANGER')"
      },
      "updated_at": {
        ".write": "auth != null && auth.token.email === 'listrik.iot.device@gmail.com'",
        ".validate": "(newData.isNumber() && newData.val() >= 0) || (newData.isString() && newData.val().length <= 40)"
      },
      "relay": {
        ".write": "auth != null && (auth.token.email === 'listrik.iot.device@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 1)"
      }
    },

    "logs": {
      ".read":  "auth != null && auth.token.isTempAccount !== true",
      ".indexOn": ["waktu", "status"],
      "$logId": {
        ".write": "auth != null && auth.token.isTempAccount !== true && !data.exists() && newData.exists() && (auth.token.email === 'listrik.iot.device@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "arus": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200"
        },
        "tegangan": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 300"
        },
        "daya": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60000"
        },
        "daya_w": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60000"
        },
        "apparent_power": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 60000"
        },
        "energi_kwh": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
        },
        "frekuensi": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 70"
        },
        "power_factor": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1.2"
        },
        "sensor_source": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'NORMAL' || newData.val() === 'WARNING' || newData.val() === 'LEAKAGE' || newData.val() === 'DANGER')"
        },
        "relay": {
          ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 1)"
        },
        "waktu": {
          ".validate": "(newData.isNumber() && newData.val() >= 0) || (newData.isString() && newData.val().length <= 40)"
        },
        "source": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "$other": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        }
      }
    },

    "notifications": {
      "system": {
        ".read": "auth != null && auth.token.isTempAccount !== true",
        ".write": false
      }
    },

    "commands": {
      ".read": "auth != null && auth.token.isTempAccount !== true && (auth.token.email === 'listrik.iot.device@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
      "relay": {
        ".write": "auth != null && auth.token.isTempAccount !== true && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.email === 'listrik.iot.device@gmail.com')",
        ".validate": "!newData.exists() || (newData.isNumber() && (newData.val() === 0 || newData.val() === 1))"
      }
    },

    "settings": {
      ".read":  "auth != null && auth.token.isTempAccount !== true && (auth.token.email === 'listrik.iot.device@gmail.com' || root.child('users').child(auth.uid).child('role').val() === 'admin')",
      ".write": "auth != null && auth.token.isTempAccount !== true && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "thresholdArus": {
        ".write": "auth != null && auth.token.isTempAccount !== true && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (auth.token.email === 'listrik.iot.device@gmail.com' && root.child('settings').child('autoLearning').child('applyToThreshold').val() === true))",
        ".validate": "newData.isNumber() && newData.val() >= 0.1 && newData.val() <= 200"
      },
      "autoLearning": {
        ".write": "auth != null && auth.token.isTempAccount !== true && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.email === 'listrik.iot.device@gmail.com')",
        "active": {
          ".validate": "newData.isBoolean()"
        },
        "status": {
          ".validate": "newData.isString() && (newData.val() === 'idle' || newData.val() === 'running' || newData.val() === 'complete' || newData.val() === 'stopped' || newData.val() === 'error')"
        },
        "requestId": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "durationMs": {
          ".validate": "newData.isNumber() && newData.val() >= 30000 && newData.val() <= 600000"
        },
        "marginPercent": {
          ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 100"
        },
        "applyToThreshold": {
          ".validate": "newData.isBoolean()"
        },
        "startedAt": {
          ".validate": "(newData.isNumber() && newData.val() >= 0) || (newData.isString() && newData.val().length <= 40)"
        },
        "finishedAt": {
          ".validate": "(newData.isNumber() && newData.val() >= 0) || (newData.isString() && newData.val().length <= 40)"
        },
        "stoppedAt": {
          ".validate": "(newData.isNumber() && newData.val() >= 0) || (newData.isString() && newData.val().length <= 40)"
        },
        "deviceUpdatedAt": {
          ".validate": "(newData.isNumber() && newData.val() >= 0) || (newData.isString() && newData.val().length <= 40)"
        },
        "startedBy": {
          ".validate": "newData.isString() && newData.val().length <= 160"
        },
        "stoppedBy": {
          ".validate": "newData.isString() && newData.val().length <= 160"
        },
        "message": {
          ".validate": "newData.isString() && newData.val().length <= 240"
        },
        "$metric": {
          ".validate": "newData.isNumber() || newData.isString() || newData.isBoolean()"
        }
      },
      "deviceBootstrap": {
        "pending": {
          ".write": "auth != null && auth.token.isTempAccount !== true && (root.child('users').child(auth.uid).child('role').val() === 'admin' || auth.token.email === 'listrik.iot.device@gmail.com')"
        },
        "status": {
          ".write": "auth != null && auth.token.email === 'listrik.iot.device@gmail.com'"
        },
        "statusMessage": {
          ".write": "auth != null && auth.token.email === 'listrik.iot.device@gmail.com'"
        },
        "lastSeenAt": {
          ".write": "auth != null && auth.token.email === 'listrik.iot.device@gmail.com'"
        },
        "lastAppliedRequestId": {
          ".write": "auth != null && auth.token.email === 'listrik.iot.device@gmail.com'"
        },
        "lastConfirmedAt": {
          ".write": "auth != null && auth.token.email === 'listrik.iot.device@gmail.com'"
        },
        "lastAction": {
          ".write": "auth != null && auth.token.email === 'listrik.iot.device@gmail.com'"
        },
        "activeSsid": {
          ".write": "auth != null && auth.token.email === 'listrik.iot.device@gmail.com'"
        },
        "deviceIp": {
          ".write": "auth != null && auth.token.email === 'listrik.iot.device@gmail.com'"
        },
        "lastError": {
          ".write": "auth != null && auth.token.email === 'listrik.iot.device@gmail.com'"
        },
        "restartRequired": {
          ".write": "auth != null && auth.token.email === 'listrik.iot.device@gmail.com'"
        }
      }
    },

    "users": {
      ".read": "auth != null && auth.token.isTempAccount !== true && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid && auth.token.isTempAccount !== true",
        ".write": "auth != null && auth.token.isTempAccount !== true && root.child('users').child(auth.uid).child('role').val() === 'admin'",
        "email": {
          ".write": "auth != null && auth.token.isTempAccount !== true && auth.uid === $uid && !data.exists() && newData.isString() && newData.val() === auth.token.email"
        },
        "displayName": {
          ".write": "auth != null && auth.token.isTempAccount !== true && auth.uid === $uid && newData.isString() && newData.val().length <= 120"
        },
        "createdAt": {
          ".write": "auth != null && auth.token.isTempAccount !== true && auth.uid === $uid && !data.exists()"
        },
        "created_at": {
          ".write": "auth != null && auth.token.isTempAccount !== true && auth.uid === $uid && !data.exists()"
        },
        "updatedAt": {
          ".write": "auth != null && auth.token.isTempAccount !== true && auth.uid === $uid"
        },
        "lastLoginAt": {
          ".write": "auth != null && auth.token.isTempAccount !== true && auth.uid === $uid"
        },
        "role": {
          ".write": "auth != null && auth.token.isTempAccount !== true && (root.child('users').child(auth.uid).child('role').val() === 'admin' || (!data.exists() && auth.uid === $uid && newData.val() === 'user'))"
        }
      }
    },

    "sim": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid && auth.token.isTempAccount === true",
        ".write": "auth != null && auth.uid === $uid && auth.token.isTempAccount === true"
      }
    },

    "temp_sessions": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "fcm_tokens": {
      "web": {
        "$uid": {
          ".read": "auth != null && auth.token.isTempAccount !== true && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
          ".write": "auth != null && auth.token.isTempAccount !== true && auth.uid === $uid && newData.isString() && newData.val().length <= 4096"
        }
      }
    }

  }
}
