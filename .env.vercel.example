# Vercel environment template for IoT Listrik Dashboard
# Safe to commit: replace every placeholder before use.
#
# Recommended Vercel env names:
# - FIREBASE_SERVICE_ACCOUNT
# - FIREBASE_DATABASE_URL
# - FIREBASE_PROJECT_ID
# - RESEND_API_KEY
# - CRON_SECRET
# - ALLOWED_ORIGINS

FIREBASE_DATABASE_URL=https://iot-listrik-dashboard-default-rtdb.asia-southeast1.firebasedatabase.app/
FIREBASE_PROJECT_ID=iot-listrik-dashboard
RESEND_API_KEY=re_replace_with_resend_api_key
CRON_SECRET=replace_with_long_random_secret_for_cleanup_route
ALLOWED_ORIGINS=https://iot-listrik-dashboard.vercel.app,https://www.iot-listrik-dashboard.vercel.app
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"iot-listrik-dashboard","private_key_id":"replace_me","private_key":"-----BEGIN PRIVATE KEY-----\\nreplace_me\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-xxxxx@iot-listrik-dashboard.iam.gserviceaccount.com","client_id":"replace_me","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40iot-listrik-dashboard.iam.gserviceaccount.com","universe_domain":"googleapis.com"}
